# ─────────────────────────────────────────────────────────────────────────────
# Strategic OSINT Radar — External Configuration
# Copy this file to config.env and fill in your API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Proxy & SSL Settings ─────────────────────────────────────────────────────
# Set the following if running behind a corporate proxy.
HTTP_PROXY=
HTTPS_PROXY=

# Set to false if you get CERTIFICATE_VERIFY_FAILED due to SSL inspection.
SSL_VERIFY=true

# ── Cloudflare Radar API Token ────────────────────────────────────────────────
# Required: Cloudflare Radar (Read)
CF_API_TOKEN=

# ── OpenWeatherMap API Key ────────────────────────────────────────────────────
# Optional: used for weather noise filtering
OWM_API_KEY=

# ── Additional Sensor API Keys ────────────────────────────────────────────────
# NASA FIRMS API key is no longer used — sensor switched to NASA EONET (no key required)

# ThreatFox API (Optional: abuse.ch allows 1-day IoC fetch without a key, but reserved for future expansion)
THREATFOX_API_KEY=

# ── Security ────────────────────────────────────────────────────────────────
# Set to true to enable Flask debug mode (stack traces, auto-reload). NEVER enable in production.
FLASK_DEBUG=false

# ── System Parameters ─────────────────────────────────────────────────────────
CURRENT_DATE_RANGE=1d
BASELINE_DATE_RANGE=7d
CACHE_EXPIRY=900
SERVER_HOST=127.0.0.1  # Docker / 外部公開する場合は 0.0.0.0 (docker-compose.yml が上書き)
SERVER_PORT=8000

AIRSPACE_ANOMALY_THRESHOLD=0.40
AIRSPACE_CLOSURE_THRESHOLD=0.05
AIRSPACE_WINDOW=20

# Observed values preceding military tension: -12 to -15. Pre-invasion: -18 to -25. Lowered to -15.0 for early warning.
GDELT_TONE_ALERT_THRESHOLD=-15.0
GDELT_HISTORY_WINDOW=28

CONVERGENCE_DUAL_BONUS=1
CONVERGENCE_FULL_BONUS=2
THREAT_LEVEL_HYSTERESIS_CYCLES=1

# Domain weights for convergence scoring (must sum to 1.0)
# Adjust to reflect operational priorities
DOMAIN_WEIGHT_CYBER=0.50
DOMAIN_WEIGHT_PHYSICAL=0.30
DOMAIN_WEIGHT_INFO=0.20

# Scenario-centric scoring (ADR-005/P1): analysts select a focused scenario,
# and per-country lists (core/correlates/adversaries) are derived from its
# participants at request time.
DEFAULT_FOCUSED_SCENARIO=taiwan_contingency

# ── Shadow Sampling (ADR-025) ────────────────────────────────────────────────
# Background harness that synthesises (lite, full) score pairs for non-focused
# scenarios on each focused scoring cycle so the C-medium recommendation has
# data without depending on analyst focus rotation.
# Set false to disable and revert to analyst-only focus_switch_log behaviour.
SHADOW_SAMPLING_ENABLED=true
# Reserved for future dedicated cadence; 0 = piggyback on focused cycle.
SHADOW_SAMPLING_INTERVAL_SEC=0
# Per-scenario lockout (anti-thrash). A scenario won't be re-sampled within
# this window even if it's the least-recent.
SHADOW_SAMPLING_MIN_GAP_SEC=300
# Global daily cap on shadow rows written to focus_switch_log.
SHADOW_SAMPLING_MAX_PER_DAY=200
# When true, only sample background scenarios that share at least one
# participant country with the focused scenario.
SHADOW_SAMPLING_REQUIRE_OVERLAP=false
# Skip shadow sampling for the first N seconds after process start so
# baselines stabilise.
SHADOW_SAMPLING_WARMUP_SEC=600
# Miss threshold for shadow-sourced rows. Typically more conservative than
# C_MEDIUM_DELTA_MISS (which still applies to analyst-sourced rows).
C_MEDIUM_DELTA_MISS_SHADOW=1.4

# ── Deep Pattern Analysis ────────────────────────────────────────────────────

# --- A. DDoS Acceleration Engine ---
# Z-score threshold for Ambush pattern detection on the 2nd derivative of threat score (default: 2.0)
AMBUSH_ZSCORE_THRESHOLD=2.0
# Rolling window size used for velocity/acceleration calculation (default: 5)
DERIVATIVE_WINDOW=5
# Maximum time delta for source synchronization detection (ms, default: 500)
SYNC_DELTA_MS=500
# C2 determination threshold for synchronization score (0.0–1.0, default: 0.70)
SYNC_C2_THRESHOLD=0.70

# --- B. Narrative Burst Detector (RSS Z-Score) ---
# Z-score threshold for narrative burst alert (default: 2.0)
NARRATIVE_ZSCORE_ALERT=2.0
# Z-score threshold for critical narrative operation determination (default: 3.0)
NARRATIVE_ZSCORE_CRITICAL=3.0
# Number of days to retain Z-score baseline (default: 30)
NARRATIVE_BASELINE_DAYS=30
# RSS fetch interval (seconds, default: 1800 = 30 min)
NARRATIVE_POLL_INTERVAL=1800

# --- C. Sequence Scorer ---
# Escalation chain verification window (seconds, default: 86400 = 24h)
SEQUENCE_WINDOW=86400
# Bonus points for full chain confirmation (default: 3)
SEQUENCE_FULL_BONUS=3
# Bonus points for partial chain (3 events) (default: 1)
SEQUENCE_PARTIAL_BONUS=2

# --- D. Maritime AIS Sensor ---
# AIS Dark Gap detection threshold (seconds, default: 3600 = 1h)
AIS_DARK_GAP_THRESHOLD=3600
# Anchoring anomaly detection radius near straits (km, default: 50)
AIS_ANCHOR_RADIUS_KM=50

# --- E. ISR Hotspot Sensor ---
# ISR aircraft type filter (ICAO type codes, comma-separated)
ISR_ICAO_TYPES=RC135,RC-135,E3,E-3,RQ4,RQ-4,P8,P-8,EP3,EP-3,U2,TR1,E8,E-8,J-STARS
# ISR surge detection threshold (number of target aircraft within hotspot radius, default: 3)
ISR_SURGE_THRESHOLD=3
# GPS jamming detection thresholds (live-reload). Level scale 0–10 from GPSJam.
GPS_JAM_THRESHOLD=3.0
GPS_JAM_CRITICAL_THRESHOLD=7.0
# CT log scoring redesigned (ADR-024): identity-match (untrusted CA / wildcard
# at gov-TLD) replaces surge-volume thresholding. CT_LOG_SURGE_THRESHOLD removed.
# CT log push source (Calidog certstream). Default DISABLED: as of
# 2026-04-23 the public wss://certstream.calidog.io/* upstream accepts
# connections, sends zero messages, and server-closes with code 1000 at
# ~60s. Reproduced with bare websocket-client and a browser User-Agent.
# Pull sources (certspotter + crt.sh) carry CT coverage until upstream is
# restored or an alternative push feed is identified. Set =true to retry.
CT_LOG_CERTSTREAM_ENABLED=false
CT_LOG_CERTSTREAM_URL=wss://certstream.calidog.io/full-stream
# Liveness budget (UI/health reporting only): if no message arrives within this
# many seconds, health() reports degraded. Does not by itself trigger reconnect.
CT_LOG_CERTSTREAM_LIVENESS_SEC=900
# RFC 6455 ping is DISABLED by default (=0): under gevent, websocket-client's
# ping thread races the recv loop's pong handler and falsely trips ping_timeout
# every ~60s. Set >0 only on non-gevent deployments.
CT_LOG_CERTSTREAM_PING_INTERVAL=0
CT_LOG_CERTSTREAM_PING_TIMEOUT=0
# Application-layer watchdog: force-close the ws when no Calidog heartbeat
# (~30s cadence) has arrived for this many seconds, then reconnect.
CT_LOG_CERTSTREAM_HEARTBEAT_BUDGET_SEC=120
# Reconnect backoff ceiling (capped exponential 1s, 2s, 4s, ... up to this).
CT_LOG_CERTSTREAM_RECONNECT_MAX_SEC=60
# USGS minimum magnitude for seismic events (live-reload)
USGS_MIN_MAGNITUDE=4.0

# --- F. OpenSky Network Authentication ---
# Basic auth deprecated after 2026-03-18. Use OAuth2 Client Credentials flow.
# Generate Client ID/Secret from opensky-network.org account settings → API Client.
# When configured, request limit increases from 400 → 4000 req/day. Anonymous access used if unset.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Minimum wait time between requests (seconds, default: 10s; can be reduced to 5s when authenticated)
OPENSKY_MIN_INTERVAL=10

# ── GreyNoise API Key ──────────────────────────────────────────────────────────
# Get key at: https://www.greynoise.io/plans/community (Community: free / Enterprise: paid)
# Community key: GNQL Stats unavailable. noise_ratio not calculated; gnql_tier=community_limited.
# Enterprise key: GNQL Stats API (v2/experimental/gnql/stats) noise suppression enabled.
GREYNOISE_API_KEY=

# ── Check-Host.net ────────────────────────────────────────────────────────────
# Comma-separated list of global nodes to use
# Available nodes: https://check-host.net/nodes/hosts
# Leave blank to use the default node set
CHECKHOST_NODES=jp1.node.check-host.net,us1.node.check-host.net,de1.node.check-host.net,nl1.node.check-host.net,fr1.node.check-host.net
# Check-Host polling interval (seconds). Can be set long since it only triggers on DDoS acceleration spikes.
CHECKHOST_POLL_INTERVAL=600
# Maximum latency (ms) to consider an HTTP response successful
CHECKHOST_TIMEOUT_MS=3000

# ── TelegramMirrorSensor ───────────────────────────────────────────────────────
# t.me/s/ public web preview polling interval (seconds)
TELEGRAM_MIRROR_POLL_INTERVAL=900
# Keywords to detect attack declaration patterns (regex supported)
TELEGRAM_ATTACK_KEYWORDS="target,attack,ddos,http flood,under attack,down,offline,op,#target"
# Claim confidence threshold: channels with mean confidence_weight below this have score reduced by 1
TELEGRAM_CLAIM_CONFIDENCE_THRESHOLD=0.5
# Maximum post age (hours) to analyze. Posts older than this are ignored to prevent stale detections.
# Must be > sensor poll interval (15min) and cover circuit breaker recovery window.
TELEGRAM_POST_MAX_AGE_HOURS=8

# ── HacktivistNewsSensor ──────────────────────────────────────────────────────
# Security news RSS feed polling interval (seconds, default: 1800 = 30 min)
HACKTIVIST_NEWS_POLL_INTERVAL=1800

# ── State Persistence ────────────────────────────────────────────────────────
# Auto-save interval in seconds (default: 300 = 5 min). State is also saved on clean shutdown.
PERSISTENCE_SAVE_INTERVAL=300

# ── Authentication (JWT) ──────────────────────────────────────────────────────
# Default admin password (used on first startup only, change via API after)
# If empty, a random password is generated and logged on first run.
DEFAULT_ADMIN_PASSWORD=
# JWT secret key (leave empty to auto-generate and persist on first startup)
JWT_SECRET_KEY=
# Token expiry in seconds
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=86400

# ── Alert Notifications ──────────────────────────────────────────────────────
# Set to "false" to disable all external notifications
NOTIFY_ENABLED=true
# Slack Incoming Webhook URL (leave empty to skip)
NOTIFY_SLACK_WEBHOOK=
# Microsoft Teams Incoming Webhook URL (leave empty to skip)
NOTIFY_TEAMS_WEBHOOK=
# Generic HTTP POST webhook URL (leave empty to skip)
NOTIFY_WEBHOOK_URL=
# Debounce: minimum seconds between same-type alerts (default: 300)
NOTIFY_DEBOUNCE_SEC=300

# ── Plugin Sensors ────────────────────────────────────────────────────────────
# Directory to scan for BaseSensor plugin files (default: plugins/)
PLUGIN_DIR=plugins
# Comma-separated plugin names to enable, or "*" for all
PLUGIN_ENABLED=*
# Comma-separated plugin names to explicitly disable
PLUGIN_DISABLED=

# ── LLM Intelligence ──────────────────────────────────────────────────────────
# Set to true to enable LLM-powered text analysis (requires Ollama running locally)
LLM_ENABLED=false
# Ollama API endpoint
LLM_HOST=http://localhost:11434
# Model to use (e.g. llama3.2:3b, llama3.1:8b, mistral:7b)
LLM_MODEL=llama3.2:3b
# Analysis request timeout in seconds
LLM_TIMEOUT=30
# confidence >= this value → AUTO-CONFIRMED and score applied immediately (analyst can override within 1h)
LLM_AUTO_CONFIRM_THRESHOLD=0.80
# confidence < this value → discarded silently (not shown in panel)
# Lowered from 0.55 → 0.35 after observability showed military_exercise
# averaging 0.39 (all items silently dropped). Sensitivity > precision.
LLM_CONFIDENCE_MIN=0.35
# Seconds within which an AUTO-CONFIRMED item can be overridden by analyst
LLM_OVERRIDE_WINDOW=3600
# Number of days to retain intel items in DB
INTEL_RETENTION_DAYS=7
# Hours to display rejected/overridden items in the Intel panel before hiding (default: 8)
INTEL_TERMINAL_DISPLAY_HOURS=8
# Diplomatic sensor poll interval in seconds (default: 3600 = 1 hour)
DIPLOMATIC_POLL_INTERVAL=3600
# Military exercise sensor poll interval in seconds (default: 3600 = 1 hour)
MILITARY_EXERCISE_POLL_INTERVAL=3600

# ────────────────────────────────────────────────────────────────────────
# v2.0 migration feature flags (docs/design/v2-migration.md)
# All default to false; v2 ships in shadow mode until ADR-V2-002 sunset.
# Enable order for opt-in: ledger → llm_prompt → diff_sampler → api
# ────────────────────────────────────────────────────────────────────────
# Phase 1 priority 1: shadow-write derived TL into the conclusions ledger.
# Required for V2_API_ENABLED to serve any data.
V2_CONCLUSION_LEDGER_ENABLED=false
# Phase 1 priority 2: persist every LLM prompt (sha256 dedup) for NP6 audit_trace.
# Required if you want /api/v2/conclusions/<id>/audit_trace to resolve prompts.
V2_LLM_PROMPT_PERSISTENCE_ENABLED=false
# Phase 1 priority 6: sample v1/v2 TL divergence into conclusion_diff_log.
# Surfaced via /api/v2/admin/conclusion_diff_stats (analyst-only).
V2_CONCLUSION_DIFF_SAMPLER_ENABLED=false
# Phase 1 priority 4: expose read-only /api/v2/* endpoints. 503 when off.
V2_API_ENABLED=false
# Phase 2 individual-rollback flags. Each derives one ConclusionType into the
# ledger; can be disabled in isolation if a deriver misbehaves.
# All imply V2_CONCLUSION_LEDGER_ENABLED.
V2_TREND_ENABLED=false
V2_PER_DOMAIN_ENABLED=false
V2_ATTACK_MODE_ENABLED=false
# NP5+8 enforcement: log per-cycle (scenario, type) availability and surface
# pairs that have been unavailable for >= V2_CONTINUITY_FAILURE_SEC.
V2_CONTINUITY_LOG_ENABLED=false
V2_CONTINUITY_FAILURE_SEC=604800
# NP7 disclaimer text appended to every v2 envelope. Override per organization.
# V2_NP7_DISCLAIMER="This output is one node in your intelligence process. ..."

# ────────────────────────────────────────────────────────────────────────
# v2.0 Phase 2 ground-truth ETL (ADR-V2-005)
# ────────────────────────────────────────────────────────────────────────
# scripts/run_ground_truth_etl.py auto-correlates conclusions against
# ACLED political-violence events + GDELT tone spikes and writes
# auto-feedback rows (analyst_id="auto:acled" / "auto:gdelt") into
# analyst_feedback. Default off — opt-in per NP3.
V2_GROUND_TRUTH_ETL_ENABLED=false
# ACLED API credentials (https://acleddata.com/register-for-api-access/)
ACLED_API_KEY=
ACLED_API_EMAIL=
# Forward window for matching escalation evidence to a conclusion (hours).
GROUND_TRUTH_WINDOW_HOURS=72
# A high-confidence conclusion older than this with zero corroborating
# evidence is auto-labeled FALSE_POSITIVE. Mirrors the inconclusive
# continuity rule (ADR-V2-010) so noise patterns line up.
GROUND_TRUTH_FALSE_POSITIVE_HORIZON_DAYS=7
# An ACLED event with this many fatalities (or more) inside the forward
# window flips a TL=1 conclusion to FALSE_NEGATIVE — the NP1-critical
# case where the tool stayed quiet through a real escalation.
GROUND_TRUTH_FALSE_NEGATIVE_FATALITIES=10

# ────────────────────────────────────────────────────────────────────────
# v2.0 operating modes (docs/design/v2-migration.md §2 rollout phases)
# ────────────────────────────────────────────────────────────────────────
# Mode A — v1 only (default): all V2_* flags = false. Nothing v2 runs.
#
# Mode B — Shadow-write (Phase 1.3 observation):
#   V2_CONCLUSION_LEDGER_ENABLED=true
#   V2_LLM_PROMPT_PERSISTENCE_ENABLED=true   # required for audit_trace
#   V2_CONCLUSION_DIFF_SAMPLER_ENABLED=true  # optional, recommended
#   V2_API_ENABLED=false                     # public API still off
#   What happens: every compute_scenario_score tick writes 5 Conclusion
#   rows (THREAT_LEVEL, TREND, PER_DOMAIN, ANOMALY, ATTACK_MODE) to
#   conclusions_ledger. v1 scoring path is unaffected (errors swallowed).
#   How to verify: GET /api/v2/admin/shadow_write_metrics (admin auth)
#   should show success_count incrementing for all 5 types and
#   failure_count == 0. ledger_enabled in the response confirms the flag.
#   Storage budget: ~5 rows per scoring tick × 60s default cadence ×
#   ~5 scenarios → ~36k rows/day. Run `du -sh radar/persistence/radar.db`
#   weekly during shadow observation. Consider pruning after Phase 2.
#   Observation goal: zero failures over 14 days, then advance to opt-in.
#
# Mode C — Opt-in v2 (Phase 1.4):
#   All Mode B flags + V2_API_ENABLED=true. /api/v2/* routes serve data
#   to clients that explicitly request the v2 envelope. v1 is still the
#   default for legacy clients.
#
# After ADR-V2-002 default-on (Phase 3) v1 enters 90-day sunset.
