# ============================================================================
#  DDoS-Radar — Runtime Configuration (template)
# ============================================================================
#  Copy this file to `config.env` and fill in the secret values.
#  Section order follows the SETTINGS UI verb-based taxonomy:
#     BOOTSTRAP → INFRASTRUCTURE → ACCESS → OPERATE → TUNE → LLM → V2_MIGRATION
#  Within each section, keys are grouped by sub-domain.
#
#  Apply timing:
#     restart-required keys take effect on next process start.
#     live keys are picked up on the next scoring cycle (≤ 60 s typical).
#     bootstrap keys are read once at first start and persisted to DB.
# ============================================================================


# ─── BOOTSTRAP ──────────────────────────────────────────────────────────────
#  Read once on first start. Both auto-generate if left blank.
#  Back up `config.env` after first start so the generated values survive
#  container rebuilds.

# Default admin password for the seeded `admin` user. If empty, a random
# password is generated and printed in the startup log (one-time only).
DEFAULT_ADMIN_PASSWORD=

# JWT signing secret. If empty, a random 64-char secret is generated and
# written back into config.env on first start.
JWT_SECRET_KEY=


# ─── INFRASTRUCTURE ─────────────────────────────────────────────────────────
#  Restart-required. Server, proxy, SSL, persistence, security mode.

# Server bind address. Use 127.0.0.1 for local-only, 0.0.0.0 inside Docker.
# docker-compose.yml sets 0.0.0.0 explicitly.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Outbound HTTP(S) proxy (corporate networks). Leave blank to use the
# system-default route.
HTTP_PROXY=
HTTPS_PROXY=

# Set to false if behind a TLS-inspecting proxy that produces
# CERTIFICATE_VERIFY_FAILED errors.
SSL_VERIFY=true

# Flask debug mode. NEVER enable on a public deployment — exposes stack
# traces and code paths.
FLASK_DEBUG=false

# JWT token expiry windows. Access token lifetime should be short; refresh
# is rotated on every use.
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=86400

# State persistence flush cadence (seconds). Also flushed on clean shutdown.
PERSISTENCE_SAVE_INTERVAL=300

# Plugin sensor loader. Plugins are BaseSensor subclasses dropped into
# `plugins/`.
PLUGIN_DIR=plugins
PLUGIN_ENABLED=*
PLUGIN_DISABLED=


# ─── ACCESS ─────────────────────────────────────────────────────────────────
#  API keys, OAuth credentials, webhooks. All of these are treated as
#  secrets — `/api/v2/config/values` returns only `{set: bool, last4: str}`
#  for them, never the plaintext.

# Cloudflare Radar API token (Read-only). Required for cyber-domain BGP /
# DDoS metrics. https://dash.cloudflare.com/?to=/:account/profile/api-tokens
CF_API_TOKEN=

# OpenWeatherMap. Optional — used for weather-noise filtering on
# physical-domain anomalies. https://openweathermap.org/api
OWM_API_KEY=

# ThreatFox / abuse.ch. Optional — public 1-day fetch works without a key,
# but reserved for paid tiers. https://auth.abuse.ch/
THREATFOX_API_KEY=

# GreyNoise. Community tier returns booleans only; Enterprise tier enables
# full GNQL stats. https://www.greynoise.io/plans/community
GREYNOISE_API_KEY=

# OpenSky OAuth2 client credentials (basic auth deprecated upstream
# 2026-03-18). When set, the rate limit jumps from 400 → 4000 req/day.
# https://opensky-network.org/my-opensky/account → API Client.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ACLED political-violence data. Optional — the ground-truth ETL falls
# back to GDELT-only correlation when both vars are blank.
# OPSEC note: ACLED registration ties an email + use-case description to
# your operating organisation. Leave blank if that is a concern.
# https://acleddata.com/register-for-api-access/
ACLED_API_KEY=
ACLED_API_EMAIL=

# Outbound notification webhooks. Leave blank to skip the corresponding
# channel. The same alert can be sent to multiple channels in parallel.
NOTIFY_ENABLED=true
NOTIFY_SLACK_WEBHOOK=
NOTIFY_TEAMS_WEBHOOK=
NOTIFY_WEBHOOK_URL=
NOTIFY_DEBOUNCE_SEC=300


# ─── OPERATE ────────────────────────────────────────────────────────────────
#  Weekly tuning by the analyst: scenario focus, intel thresholds, polling
#  cadence. Live-applied (no restart needed) unless noted.

# The scenario the operator is currently focused on. Determines which
# scenario receives full sensor coverage; others run in C-lite mode.
DEFAULT_FOCUSED_SCENARIO=taiwan_contingency

# Cyber baseline / current-window date ranges. 1d / 7d is the default.
CURRENT_DATE_RANGE=1d
BASELINE_DATE_RANGE=7d

# In-memory cache TTL for sensor fetch results.
CACHE_EXPIRY=900

# LLM intel auto-confirm: confidence ≥ this value applies the score
# immediately (analyst can override within LLM_OVERRIDE_WINDOW).
LLM_AUTO_CONFIRM_THRESHOLD=0.80

# LLM intel discard floor. Items below this are dropped silently.
# Lowered from 0.55 → 0.35 after observability showed military_exercise
# averaging 0.39 (all items silently dropped). NP1: sensitivity > precision.
LLM_CONFIDENCE_MIN=0.35

# Override window for AUTO-CONFIRMED intel items (seconds).
LLM_OVERRIDE_WINDOW=3600

# DB retention for intel items (days).
INTEL_RETENTION_DAYS=7

# Hours to keep terminal-state intel (rejected/overridden) visible in the
# Intel panel before it disappears.
INTEL_TERMINAL_DISPLAY_HOURS=8

# Intel sensor poll intervals (seconds).
DIPLOMATIC_POLL_INTERVAL=3600
MILITARY_EXERCISE_POLL_INTERVAL=3600
NARRATIVE_POLL_INTERVAL=1800
HACKTIVIST_NEWS_POLL_INTERVAL=1800
TELEGRAM_MIRROR_POLL_INTERVAL=900

# Check-Host node poll cadence and timeout. Long cadence is fine — only
# triggers on DDoS-acceleration spikes.
CHECKHOST_POLL_INTERVAL=600
CHECKHOST_TIMEOUT_MS=3000
CHECKHOST_NODES=jp1.node.check-host.net,us1.node.check-host.net,de1.node.check-host.net,nl1.node.check-host.net,fr1.node.check-host.net

# OpenSky inter-request floor (seconds). Drop to 5 s when authenticated.
OPENSKY_MIN_INTERVAL=10


# ─── TUNE ───────────────────────────────────────────────────────────────────
#  Monthly tuning of scoring internals: domain weights, thresholds,
#  sequence bonuses, sensor-specific tunables.

# Domain weights for convergence scoring. MUST sum to 1.0 — the layered
# config registry rejects values that violate the sum invariant.
DOMAIN_WEIGHT_CYBER=0.50
DOMAIN_WEIGHT_PHYSICAL=0.30
DOMAIN_WEIGHT_INFO=0.20

# Convergence bonuses (raw points added when ≥ N domains fire).
CONVERGENCE_DUAL_BONUS=1
CONVERGENCE_FULL_BONUS=2

# Threat-level hysteresis. N consecutive cycles required before TL changes
# direction. Prevents flicker from single-cycle outliers.
THREAT_LEVEL_HYSTERESIS_CYCLES=1

# --- Airspace ---
AIRSPACE_ANOMALY_THRESHOLD=0.40
AIRSPACE_CLOSURE_THRESHOLD=0.05
AIRSPACE_WINDOW=20

# --- GDELT ---
# Observed values preceding military tension: −12 to −15. Pre-invasion:
# −18 to −25. Lowered to −15.0 for early warning.
GDELT_TONE_ALERT_THRESHOLD=-15.0
GDELT_HISTORY_WINDOW=28

# --- DDoS Acceleration Engine ---
AMBUSH_ZSCORE_THRESHOLD=2.0
DERIVATIVE_WINDOW=5
SYNC_DELTA_MS=500
SYNC_C2_THRESHOLD=0.70

# --- Narrative Burst Detector (RSS) ---
NARRATIVE_ZSCORE_ALERT=2.0
NARRATIVE_ZSCORE_CRITICAL=3.0
NARRATIVE_BASELINE_DAYS=30

# --- Sequence Scorer ---
# Escalation-chain verification window (seconds, default 86400 = 24 h).
SEQUENCE_WINDOW=86400
SEQUENCE_FULL_BONUS=3
SEQUENCE_PARTIAL_BONUS=2

# --- Maritime AIS ---
AIS_DARK_GAP_THRESHOLD=3600
AIS_ANCHOR_RADIUS_KM=50

# --- ISR ---
ISR_SURGE_THRESHOLD=3
GPS_JAM_THRESHOLD=3.0
GPS_JAM_CRITICAL_THRESHOLD=7.0

# --- USGS seismic ---
USGS_MIN_MAGNITUDE=4.0

# --- CT log (ADR-024 trust-class redesign) ---
# Calidog certstream upstream: as of 2026-04-23 the public stream
# accepts the connection, sends zero messages, and server-closes after
# ~60 s. Pull sources (certspotter + crt.sh) carry CT coverage until the
# push feed is restored. Set =true to retry the push connection.
CT_LOG_CERTSTREAM_ENABLED=false
CT_LOG_CERTSTREAM_URL=wss://certstream.calidog.io/full-stream
# Liveness budget (UI / health reporting only). Liveness alone never
# triggers a reconnect — that is the heartbeat watchdog's job.
CT_LOG_CERTSTREAM_LIVENESS_SEC=900
# RFC 6455 ping is OFF by default (=0): under gevent, websocket-client's
# ping thread races the recv-loop pong handler and falsely trips
# ping_timeout every ~60 s. Set >0 only on non-gevent deployments.
CT_LOG_CERTSTREAM_PING_INTERVAL=0
CT_LOG_CERTSTREAM_PING_TIMEOUT=0
# Application-layer watchdog. Force-close the ws when no Calidog
# heartbeat (~30 s cadence) has arrived for this many seconds.
CT_LOG_CERTSTREAM_HEARTBEAT_BUDGET_SEC=120
# Reconnect backoff ceiling (capped exponential 1 s, 2 s, 4 s, … up to this).
CT_LOG_CERTSTREAM_RECONNECT_MAX_SEC=60

# --- Telegram (claim sensor) ---
TELEGRAM_ATTACK_KEYWORDS="target,attack,ddos,http flood,under attack,down,offline,op,#target"
# Channels with mean confidence_weight below this have their score
# reduced by 1 — penalises low-trust noise generators.
TELEGRAM_CLAIM_CONFIDENCE_THRESHOLD=0.5
# Maximum post age to analyse (hours). Must exceed sensor poll interval
# (15 min) AND the circuit-breaker recovery window.
TELEGRAM_POST_MAX_AGE_HOURS=8

# --- Auto-Judge Recheck (deterministic + optional LLM second pass) ---
# Floor for deterministic CONFIRM. Item must clear this AND have ≥ 1
# independent corroborator within the same scenario.
AUTO_JUDGE_CONF_CONFIRM_FLOOR=0.70
# Ceiling for deterministic REJECT (when no corroboration found).
AUTO_JUDGE_CONF_REJECT_CEILING=0.40
# Lookback for corroborators / duplicates (hours).
AUTO_JUDGE_CORROBORATION_HOURS=72
# Pending items older than this with zero corroborators auto-reject.
AUTO_JUDGE_STALE_HOURS=48
# Headline Jaccard similarity above which two items are deduped.
AUTO_JUDGE_DUP_JACCARD=0.70
# Source-reputation drift: false_positive ratio threshold.
AUTO_JUDGE_SOURCE_REJECT_RATIO=0.75
AUTO_JUDGE_SOURCE_MIN_DECISIONS=5
# Optional LLM second pass on items the deterministic pass left pending.
# Layer 1 cross-evidence is hard-coded into the recheck path: an LLM
# verdict can ONLY flip an item that has ≥ 1 independent corroborator
# in the same scenario. Items lacking cross-evidence stay pending
# regardless of LLM confidence.
LLM_AUTO_JUDGE_RECHECK=false
AUTO_JUDGE_LLM_CONF_FLOOR=0.85
# Shadow mode — invoke LLM second pass + write to calibration ledger
# without applying the verdict. Lets ECE accrue from day 1.
LLM_AUTO_JUDGE_SHADOW=true

# --- Shadow Sampling (ADR-025) ---
# Background harness that synthesises (lite, full) score pairs for
# non-focused scenarios on each focused scoring cycle, so the C-medium
# recommendation has data without depending on analyst focus rotation.
SHADOW_SAMPLING_ENABLED=true
# 0 = piggyback on the focused cycle. Reserved for future dedicated cadence.
SHADOW_SAMPLING_INTERVAL_SEC=0
# Per-scenario lockout (anti-thrash) — minimum gap before re-sampling.
SHADOW_SAMPLING_MIN_GAP_SEC=300
# Daily cap on shadow rows written to focus_switch_log.
SHADOW_SAMPLING_MAX_PER_DAY=200
# When true, only sample background scenarios that share at least one
# participant country with the focused scenario.
SHADOW_SAMPLING_REQUIRE_OVERLAP=false
# Skip shadow sampling for the first N seconds after process start so
# baselines stabilise.
SHADOW_SAMPLING_WARMUP_SEC=600
# Miss threshold for shadow-sourced rows. Typically more conservative
# than C_MEDIUM_DELTA_MISS (which still applies to analyst-sourced rows).
C_MEDIUM_DELTA_MISS_SHADOW=1.4

# --- Background Observer (AP3 — per-scenario observation health) ---
# Closes the geographic-bias gap in the LLM intel pipeline by rotating
# round-robin through non-focused scenarios + their participant countries
# and pushing per-country signals into the next scoring tick. Anonymous
# HTTP, no API keys, no LLM dependency — but adds outbound HTTP load,
# so opt-in (NP3).
BG_OBSERVER_ENABLED=false
BG_OBSERVER_INTERVAL_SEC=300       # 5-min cycle
BG_OBSERVER_SIGNAL_TTL_SEC=1800    # signals expire after 30 min
BG_OBSERVER_MAX_QUEUE=200          # hard cap to bound memory
# Comma-separated RSS feed URLs. The implicit default in radar/config.py
# is a 4-feed mix (BBC / Al Jazeera / AP / Xinhua). Recommended Asia-
# Pacific augmented list (verified live 2026-04-29):
#   - BBC World         https://feeds.bbci.co.uk/news/world/rss.xml
#   - Al Jazeera        https://www.aljazeera.com/xml/rss/all.xml
#   - Xinhua World      http://www.xinhuanet.com/english/rss/worldrss.xml
#   - SCMP (HK/CN)      https://www.scmp.com/rss/91/feed
#   - TASS (RU)         http://tass.com/rss/v2.xml
#   - Channel News Asia https://www.channelnewsasia.com/rssfeeds/8395986
#   - Japan Times       https://www.japantimes.co.jp/feed/
#   - Yonhap (KR)       https://en.yna.co.kr/RSS/news.xml
#   - Taipei Times (TW) http://www.taipeitimes.com/xml/index.rss
# Uncomment + paste comma-separated (no spaces, no newlines):
# BG_OBSERVER_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.aljazeera.com/xml/rss/all.xml,http://www.xinhuanet.com/english/rss/worldrss.xml,https://www.scmp.com/rss/91/feed,http://tass.com/rss/v2.xml,https://www.channelnewsasia.com/rssfeeds/8395986,https://www.japantimes.co.jp/feed/,https://en.yna.co.kr/RSS/news.xml,http://www.taipeitimes.com/xml/index.rss


# ─── LLM ────────────────────────────────────────────────────────────────────
#  Ollama connection, default model fallback, per-use-case routing.

# Master enable. When false, all LLM-dependent paths fall back to
# deterministic rules.
LLM_ENABLED=false

# Ollama HTTP endpoint. Phase 8 routing requires Ollama ≥ 0.22.0 (MLX
# runtime default + FA misreporting fix). /api/v2/llm_preflight downgrades
# go_no_go=false when the version probe fails.
LLM_HOST=http://localhost:11434

# Single-model fallback used by callers that don't pass `use_case=`
# (i.e. all calls when Phase 8 routing flags below are OFF). Keep small
# so air-gapped / dev setups still get a response.
LLM_MODEL=llama3.2:3b

# Per-call timeout (seconds).
LLM_TIMEOUT=30

# --- Embedding (granite-embedding:278m — OSINT dedupe) ---
# Override here if you've pulled a different multilingual embedder
# (e.g. mxbai-embed-large for ru-language support).
LLM_EMBEDDING_MODEL=granite-embedding:278m
# Feature Hub gate. Default OFF — sensors must tolerate embed_text()
# returning None and fall back to substring/hash dedupe.
EMBEDDING_DEDUPE_ENABLED=false
# Shadow mode — embed but don't act on the result yet. Lets you measure
# Russian-source dedupe quality before promoting to ON.
EMBEDDING_DEDUPE_SHADOW=false

# --- Phase 8 — LLM routing (use_case → model) ---
#
# Three-layer override chain (highest precedence first):
#   1. /api/v2/llm_routing/overrides  (DB rows, set by analyst at runtime)
#   2. these env vars                 (operator deployment config)
#   3. radar/llm_routing.py defaults  (the survey-recommended stack)
#
# Per-use-case knob pattern:
#   LLM_ROUTING_<USECASE>_PRIMARY_MODEL          (string, e.g. gemma4:31b)
#   LLM_ROUTING_<USECASE>_PRIMARY_TEMP           (float in [0, 2])
#   LLM_ROUTING_<USECASE>_PRIMARY_TOP_P          (float in [0, 1])
#   LLM_ROUTING_<USECASE>_PRIMARY_TOP_K          (int)
#   LLM_ROUTING_<USECASE>_PRIMARY_SEED           (int)
#   LLM_ROUTING_<USECASE>_PRIMARY_NUM_PREDICT    (int — token cap)
#   LLM_ROUTING_<USECASE>_PRIMARY_REPEAT_PENALTY (float)
#   LLM_ROUTING_<USECASE>_PRIMARY_THINK          (true|false — toggles
#                                                 <|think|> for gemma4 and
#                                                 "Reasoning: high" for gpt-oss)
# Each accepts an analogous _SECONDARY_* form for the fallback choice.
# <USECASE> ∈ { SENSOR, VERDICT, CONCLUSION, DISCOVERY, NARRATIVE }
#
# Code defaults (survey v10):
#   SENSOR     primary mistral-small3.2:24b   secondary gemma4:26b
#   VERDICT    primary gemma4:26b             secondary mistral-small3.2:24b
#   CONCLUSION primary gemma4:31b             secondary gemma4:26b
#   DISCOVERY  primary gemma4:31b             secondary gpt-oss-safeguard:20b
#   NARRATIVE  primary gemma4:26b             (no secondary)
#
# Routing rolled out via four Feature Hub keys (default OFF):
#   model_routing_verdict     — roll out FIRST (re-runs verifiable)
#   model_routing_sensor
#   model_routing_etl
#   model_routing_conclusion  — roll out LAST (highest visibility)
# Each accepts SHADOW state for non-destructive A/B logging:
#   LLM_ROUTING_VERDICT_ENABLED=false
#   LLM_ROUTING_VERDICT_SHADOW=true   # records what v10 would have picked
#
# Example operator overrides (all optional):
# LLM_ROUTING_VERDICT_PRIMARY_MODEL=gemma4:26b
# LLM_ROUTING_VERDICT_PRIMARY_TEMP=0.0
# LLM_ROUTING_VERDICT_PRIMARY_TOP_K=1
# LLM_ROUTING_VERDICT_PRIMARY_SEED=42
# LLM_ROUTING_CONCLUSION_PRIMARY_MODEL=gemma4:31b
# LLM_ROUTING_CONCLUSION_PRIMARY_THINK=true


# ─── V2_MIGRATION ───────────────────────────────────────────────────────────
#  v2.0 architecture rollout flags. See docs/design/v2-migration.md for
#  the full migration plan. All default to false except where noted; v2
#  ships in shadow mode until ADR-V2-002 sunset.
#
#  Enable order for opt-in:
#     ledger → llm_prompt → diff_sampler → api

# Phase 1 P1 — shadow-write derived TL into the conclusions ledger.
# Required for V2_API_ENABLED to serve any data.
V2_CONCLUSION_LEDGER_ENABLED=false

# Phase 1 P2 — persist every LLM prompt (sha256 dedup) for NP6 audit trace.
# Required if you want /api/v2/conclusions/<id>/audit_trace to resolve
# prompts.
V2_LLM_PROMPT_PERSISTENCE_ENABLED=false

# Phase 1 P6 — sample v1/v2 TL divergence into conclusion_diff_log.
# Surfaced via /api/v2/admin/conclusion_diff_stats (analyst-only).
V2_CONCLUSION_DIFF_SAMPLER_ENABLED=false

# Phase 1 P4 — expose read-only /api/v2/* endpoints. Returns 503 when off.
V2_API_ENABLED=false

# NP5+8 enforcement — chronic "cannot conclude" detection.
# `inconclusive_continuity_log` is always written by the ledger writer
# (no separate flag); this var only sets the threshold above which a
# (scenario, conclusion_type) pair is flagged as a design-failure.
# 7 days = 604_800 seconds; tighten in production if needed.
V2_CONTINUITY_FAILURE_SEC=604800

# NP7 disclaimer text appended to every v2 envelope. Override per
# organisation.
# V2_NP7_DISCLAIMER="This output is one node in your intelligence process. ..."

# --- Phase 2 ground-truth ETL (ADR-V2-005) ---
# scripts/run_ground_truth_etl.py auto-correlates conclusions against
# ACLED political-violence events + GDELT tone spikes and writes
# auto-feedback rows into analyst_feedback (analyst_id="auto:acled" /
# "auto:gdelt"). 2026-04-29: enabled by default for ACLED-free
# deployments — the pipeline now reads internal evidence sources
# (llm_intel + sequence_events) in addition to GDELT, so it produces
# auto-feedback rows even without an external API key.
V2_GROUND_TRUTH_ETL_ENABLED=true
# Forward window for matching escalation evidence to a conclusion (hours).
GROUND_TRUTH_WINDOW_HOURS=72
# A high-confidence conclusion older than this with zero corroborating
# evidence is auto-labeled FALSE_POSITIVE. Mirrors the inconclusive
# continuity rule (ADR-V2-010) so noise patterns line up.
GROUND_TRUTH_FALSE_POSITIVE_HORIZON_DAYS=7
# An ACLED event with this many fatalities (or more) inside the forward
# window flips a TL=1 conclusion to FALSE_NEGATIVE — the NP1-critical
# case where the tool stayed quiet through a real escalation.
GROUND_TRUTH_FALSE_NEGATIVE_FATALITIES=10


# ─── v2.0 Operating Modes (cheat sheet) ─────────────────────────────────────
#  Mode A — v1 only (default): all V2_* flags = false. Nothing v2 runs.
#
#  Mode B — Shadow-write (Phase 1.3 observation):
#    V2_CONCLUSION_LEDGER_ENABLED=true
#    V2_LLM_PROMPT_PERSISTENCE_ENABLED=true   # required for audit_trace
#    V2_CONCLUSION_DIFF_SAMPLER_ENABLED=true  # optional, recommended
#    V2_API_ENABLED=false                     # public API still off
#    What happens: every compute_scenario_score tick writes 5 Conclusion
#    rows (THREAT_LEVEL, TREND, PER_DOMAIN, ANOMALY, ATTACK_MODE) to
#    conclusions_ledger. v1 scoring path is unaffected (errors swallowed).
#    Verify: GET /api/v2/admin/shadow_write_metrics (admin auth) should
#    show success_count incrementing for all 5 types and failure_count
#    == 0.
#    Storage budget: ~5 rows per scoring tick × 60 s default cadence ×
#    ~5 scenarios → ~36k rows/day. Monitor `du -sh radar/persistence/`.
#
#  Mode C — Opt-in v2 (Phase 1.4):
#    All Mode B flags + V2_API_ENABLED=true. /api/v2/* routes serve data
#    to clients that explicitly request the v2 envelope. v1 is still
#    the default for legacy clients.
#
#  After ADR-V2-002 default-on (Phase 3) v1 enters its 90-day sunset.
